{
  "name": "@rdlabo/ionic-angular-collect-icons",
  "version": "3.0.2-1",
  "repository": {
    "type": "git",
    "url": "git@github.com:rdlabo-dev/ionic-angular-collect-icons.git"
  },
  "bugs": {
    "url": "git@github.com:rdlabo-dev/ionic-angular-collect-icons.git/issues"
  },
  "homepage": "https://docs.rdlabo.dev/projects/ionic-angular-collect-icons",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.js"
    },
    "./dist/index": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.js"
    },
    "./dist/*": "./dist/*",
    "./docs/*": "./docs/*",
    "./package.json": "./package.json"
  },
  "bin": "./dist/index.js",
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "start": "jiti ./src/index.ts",
    "build": "tsup",
    "dev": "tsup --watch",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "fmt": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepublishOnly": "npm run build",
    "release": "np --no-tests --no-publish"
  },
  "dependencies": {
    "@clack/core": "^0.5.0",
    "@clack/prompts": "^0.11.0",
    "@ionic/utils-terminal": "^2.3.5",
    "ionicons": "^8.0.0",
    "picocolors": "^1.1.0",
    "ts-dedent": "^2.2.0",
    "ts-morph": "^26.0.0"
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^0.34.6",
    "esbuild": "0.24.2",
    "eslint": "^8.57.0",
    "jiti": "^1.21.0",
    "np": "^10.2.0",
    "prettier": "^3.2.5",
    "tsup": "8.3.5",
    "typescript": "^5.9.0",
    "vitest": "^0.34.6"
  },
  "peerDependencies": {
    "@angular-eslint/template-parser": "^21.0.0 || ^22.0.0",
    "@angular/core": ">=18.0.0 <23.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
